<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.iu.claude-keepalive</string>

    <!-- 每 300 秒轮询一次真实 reset 时间；睡眠期间错过的会在唤醒后补跑一次 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__KA_HOME__/keepalive.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- launchd 环境很精简，显式补齐 PATH / HOME，保证能找到 node/claude/security/curl -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__KA_HOME__/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__KA_HOME__/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
